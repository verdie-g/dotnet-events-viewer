<FluentAppBar Orientation="Orientation" Style="height: 100%" aria-label="Viewer navigation">
    <FluentAppBarItem Href="list"
                      IconRest="@(new Icons.Regular.Size24.AppsList())"
                      IconActive="@(new Icons.Filled.Size24.AppsList())"
                      Text="List View"
                      OnClick="OnItemClick" />
    <FluentAppBarItem Href="tree"
                      IconRest="@(new Icons.Regular.Size24.CubeTree())"
                      IconActive="@(new Icons.Filled.Size24.CubeTree())"
                      Text="Tree View"
                      OnClick="OnItemClick" />
    <FluentAppBarItem Href="./"
                      Match="NavLinkMatch.All"
                      IconRest="@(new Icons.Regular.Size24.ArrowExit())"
                      IconActive="@(new Icons.Filled.Size24.ArrowExit())"
                      Text="Close"
                      Tooltip="Close Trace"
                      OnClick="OnItemClick" />
</FluentAppBar>

@code {
    [Parameter]
    public Orientation Orientation { get; set; } = Orientation.Vertical;

    [Parameter]
    public EventCallback<IAppBarItem> OnItemClick { get; set; }
}
