@using DotnetEventsViewer.Components

@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header" Height="50px" Style="background-color: var(--colorBrandBackground); color: var(--colorNeutralForegroundOnBrand)">
        <FluentStack Orientation="Orientation.Horizontal" Width="100%" Height="100%" VerticalAlignment="VerticalAlignment.Center">
            <FluentLayoutHamburger @ref="_navigationMenu"
                                   PanelHeader="Events Viewer"
                                   Icon="@(new Icons.Regular.Size20.Navigation().WithColor("var(--colorNeutralForegroundOnBrand)"))">
                <NavMenu Orientation="Orientation.Horizontal" OnItemClick="_ => _navigationMenu!.HideAsync()" />
            </FluentLayoutHamburger>
            .NET Events Viewer
            <FluentSpacer />
            <TraceMetadata />
            <FluentLink Href="https://github.com/verdie-g/dotnet-events-viewer"
                        Target="LinkTarget.Blank"
                        title=".NET Events Viewer on GitHub"
                        Style="margin-left: 8px; color: inherit">
                <FluentIcon Value="@(new CustomIcons.GitHub())" Width="24px" />
            </FluentLink>
        </FluentStack>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation" Width="68px">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <ErrorBoundary>
            <ChildContent>
                <div class="content">
                    @Body
                </div>
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="blazor-error-boundary">@ex.Message</div>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>
</FluentLayout>

@code {
    private FluentLayoutHamburger? _navigationMenu;
}
