@page "/list"

@using NetTrace
@using System.Linq.Expressions
@using DotnetEventsViewer.Components
@using DotnetEventsViewer.Querying
@using DotnetEventsViewer.State

@inject StateContainer State
@inject IDialogService DialogService;

<PageTitle>@State.TraceExtraMetadata!.Filename | Events List</PageTitle>

<h1>Events List</h1>

<QueryBuilder QueryType="QueryType.List" OnQuery="OnQuery" />

@if (_events != null)
{
    <FluentDataGrid
        TGridItem="Event"
        @ref="_grid"
        ItemsProvider="@_events.Provide"
        ItemKey="@(e => e.Index)"
        Virtualize="true"
        DisplayMode="DataGridDisplayMode.Table"
        ResizableColumns="true"
        OnRowClick="OnRowClick"
        ShowHover="true"
        ItemSize="32">
        <ChildContent>
            @foreach (var column in _columns)
            {
                <PropertyColumn @key="column.Field" Title="@column.Field.Name" Property="@column.Property" Sortable="true"/>
            }
        </ChildContent>
        <EmptyContent>
            No events.
        </EmptyContent>
    </FluentDataGrid>
}

@code {
    private EventGridDataSource? _events;
    private FluentDataGrid<Event>? _grid;
    private (Field Field, Expression<Func<Event, object?>> Property)[] _columns = [];

    private Task OnQuery(QueryResult queryResult)
    {
        var columns = queryResult.ColumnFields!.Select(field =>
        {
            var existing = _columns.FirstOrDefault(column => ReferenceEquals(column.Field, field));
            return existing.Property != null ? existing : (Field: field, Property: (Expression<Func<Event, object?>>)(evt => field.Selector(evt)));
        }).ToArray();
        bool clearSort = _grid != null && _grid.SortColumns.Any(sort => !columns.Any(column =>
            sort.Column is PropertyColumn<Event, object?> propertyColumn
            && ReferenceEquals(propertyColumn.Property, column.Property)));
        _events = new EventGridDataSource(queryResult.FilteredEvents);
        _columns = columns;
        return clearSort ? _grid!.RemoveSortByColumnAsync() : Task.CompletedTask;
    }

    private async Task OnRowClick(FluentDataGridRow<Event> eventRow)
    {
        var evt = eventRow.Item;
        if (evt == null) // Header row.
        {
            return;
        }

        await DialogService.ShowDrawerAsync<EventDialogContent>(options =>
        {
            options.Parameters[nameof(EventDialogContent.Content)] = evt;
            options.Alignment = DialogAlignment.End;
            options.Width = "600px";
            options.Header.Title = $"{evt.Metadata.EventName} {evt.Index}";
            options.Footer.PrimaryAction.Visible = false;
            options.Footer.SecondaryAction.Visible = false;
        });
    }

}