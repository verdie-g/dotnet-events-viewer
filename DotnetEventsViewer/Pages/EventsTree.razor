@page "/tree"

@using DotnetEventsViewer.CallTree
@using DotnetEventsViewer.Components
@using DotnetEventsViewer.Querying
@using DotnetEventsViewer.State

@inject StateContainer State

<PageTitle>@State.TraceExtraMetadata!.Filename | Events Tree</PageTitle>

<h1>Events Tree</h1>

<QueryBuilder QueryType="QueryType.Tree" OnQuery="OnQuery" />
@if (_treeView != null)
{
    <div class="events-tree">
        <FluentTreeView @key="_treeView" Items="_treeView" LazyLoadItems="true" Style="width: max-content; min-width: 100%">
            <ItemTemplate Context="item">
                <span class="events-tree-label">@item.Text</span>
            </ItemTemplate>
        </FluentTreeView>
    </div>
}

@code {
    private IEnumerable<ITreeViewItem>? _treeView;

    private void OnQuery(QueryResult queryResult)
    {
        var aggregator = queryResult.CallTreeAggregator!;
        var callTree = CallTreeNode.Create(queryResult.FilteredEvents, aggregator.CreateProcessor(), queryResult.BottomUpTree);
        var view = new CallTreeView(callTree, aggregator);
        _treeView = [view.Root];
    }
}
